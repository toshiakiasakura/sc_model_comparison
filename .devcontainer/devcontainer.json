{
    "name": "sc_model_comparison",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "..",
        "args": {
            "CLAUDE_CODE_VERSION": "latest"
        }
    },
    "mounts": [
        "source=${localWorkspaceFolder},target=/workdir,type=bind,consistency=cached",
        // Persist Claude Code config and auth across container rebuilds
        "source=sc-model-claude-config-${devcontainerId},target=/home/jovyan/.claude,type=volume"
    ],
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.shell.linux": "/bin/bash",
                "workbench.editorAssociations": {
                    "*.ipynb": "jupyter-notebook"
                },
                "jupyter.allowLocalServer": true,
                "jupyter.jupyterServerType": "local"  // Ensures Jupyter uses local server
            },
            "extensions": [
                "anthropic.claude-code",
                "julialang.language-julia",
                "0h7z.vscode-julia-format",
                "ms-toolsai.jupyter",
                "donjayamanne.vscode-jupytext",
                "REditorSupport.r",
                "RDebugger.r-debugger",
                "ms-python.python",
                "znck.grammarly",
                "janisdd.vscode-edit-csv",
                "GitHub.copilot",
                "Gruntfuggly.todo-tree",
                "ms-azuretools.vscode-docker"
            ]
        }
    },
    "remoteEnv": {
        // Pass your ANTHROPIC_API_KEY from the host environment
        "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}"
    },
    "forwardPorts": [
        8888 // Port for Jupyter Notebook
    ],
    "postCreateCommand": "julia --project=/workdir -e 'using Pkg; Pkg.activate(\"/workdir\"); Pkg.instantiate();'",
    "remoteUser": "jovyan",
    "workspaceFolder": "/workdir",
    "shutdownAction": "stopContainer",
    "containerEnv": {
        "JULIA_NUM_THREADS": "12"
    }
}